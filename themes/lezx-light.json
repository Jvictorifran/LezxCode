{
  "name": "Lezx Light",
  "type": "light",
  "colors": {
    "foreground": "#3b3f4c",
    "focusBorder": "#6a4cf0",
    "editor.background": "#fbfbfd",
    "editor.foreground": "#2b2f3a",
    "editor.lineHighlightBackground": "#f1f1f6",
    "editor.selectionBackground": "#d9d2ff",
    "editorCursor.foreground": "#6a4cf0",
    "editorLineNumber.foreground": "#b3b6c2",
    "editorLineNumber.activeForeground": "#545866",
    "editorWidget.background": "#ffffff",
    "activityBar.background": "#efeff4",
    "activityBar.foreground": "#2b2f3a",
    "activityBar.inactiveForeground": "#9a9dab",
    "sideBar.background": "#f4f4f8",
    "sideBar.foreground": "#4a4e5c",
    "list.hoverBackground": "#e8e8f0",
    "list.activeSelectionBackground": "#e0dafd",
    "list.activeSelectionForeground": "#1a1d26",
    "titleBar.activeBackground": "#efeff4",
    "titleBar.activeForeground": "#5b5f6e",
    "editorGroupHeader.tabsBackground": "#efeff4",
    "tab.activeBackground": "#fbfbfd",
    "tab.activeForeground": "#1a1d26",
    "tab.inactiveBackground": "#efeff4",
    "tab.inactiveForeground": "#7e8292",
    "tab.activeBorderTop": "#6a4cf0",
    "tab.border": "#e2e2ea",
    "statusBar.background": "#efeff4",
    "statusBar.foreground": "#5b5f6e",
    "statusBarItem.hoverBackground": "#e2e2ea",
    "panel.background": "#f4f4f8",
    "panel.border": "#e2e2ea",
    "input.background": "#ffffff",
    "input.foreground": "#2b2f3a",
    "input.border": "#d9d9e3",
    "button.background": "#6a4cf0",
    "button.foreground": "#ffffff",
    "scrollbarSlider.background": "#00000014",
    "scrollbarSlider.hoverBackground": "#00000024",
    "terminal.background": "#f4f4f8",
    "terminal.foreground": "#2b2f3a",
    "terminalCursor.foreground": "#6a4cf0",
    "terminal.ansiBlack": "#2b2f3a",
    "terminal.ansiRed": "#d6345a",
    "terminal.ansiGreen": "#1f9d55",
    "terminal.ansiYellow": "#b7791f",
    "terminal.ansiBlue": "#2f6fd6",
    "terminal.ansiMagenta": "#8a4cf0",
    "terminal.ansiCyan": "#0f8f8c",
    "terminal.ansiWhite": "#9a9dab",
    "terminal.ansiBrightBlack": "#5b5f6e",
    "terminal.ansiBrightWhite": "#2b2f3a"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#9a9dab", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#1f8a4c" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#c2570c" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#7b3fe4" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#2f6fd6" } },
    { "scope": ["entity.name.type", "support.class"], "settings": { "foreground": "#a8650a" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#d6345a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#a8650a" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#0f7f9c" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#c2570c" } },
    { "scope": ["punctuation", "delimiter"], "settings": { "foreground": "#6b6f7e" } }
  ]
}
