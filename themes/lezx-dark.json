  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f6578", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9fe0a8" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ffb86c" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#c49bff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7aa8ff" } },
    { "scope": ["entity.name.type", "support.class", "entity.name.class"], "settings": { "foreground": "#ffd479" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff7aa2" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ffd479", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#6fe3e1" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["variable"], "settings": { "foreground": "#d4d7e0" } },
    { "scope": ["punctuation", "delimiter"], "settings": { "foreground": "#8a90a2" } }
  ]
}
