{
  "name": "Go",
  "publisher": "Lezx",
  "version": "1.0.0",
  "icon": {
    "text": "go",
    "color": "#00add8"
  },
  "description": "IntelliSense e erros com o gopls (precisa do Go instalado). Para instalar o gopls: go install golang.org/x/tools/gopls@latest",
  "languages": [
    "go"
  ],
  "server": {
    "command": "gopls",
    "installHint": "go install golang.org/x/tools/gopls@latest"
  },
  "keywords": [
    "break",
    "case",
    "chan",
    "const",
    "continue",
    "default",
    "defer",
    "else",
    "fallthrough",
    "for",
    "func",
    "go",
    "goto",
    "if",
    "import",
    "interface",
    "map",
    "package",
    "range",
    "return",
    "select",
    "struct",
    "switch",
    "type",
    "var",
    "nil",
    "true",
    "false"
  ],
  "functions": [
    {
      "label": "Println",
      "insert": "fmt.Println(${1})"
    },
    {
      "label": "Printf",
      "insert": "fmt.Printf(\"${1:%v}\\n\", ${2})"
    },
    {
      "label": "make",
      "insert": "make(${1:[]int}, ${2:0})"
    },
    {
      "label": "append",
      "insert": "append(${1:lista}, ${2})"
    },
    {
      "label": "len",
      "insert": "len(${1})"
    }
  ],
  "snippets": {
    "main": {
      "prefix": "main",
      "body": [
        "package main",
        "",
        "import \"fmt\"",
        "",
        "func main() {",
        "\t$0",
        "}"
      ],
      "description": "Programa Go"
    },
    "iferr": {
      "prefix": "iferr",
      "body": [
        "if err != nil {",
        "\treturn ${1:err}",
        "}"
      ],
      "description": "if err != nil"
    },
    "func": {
      "prefix": "func",
      "body": [
        "func ${1:nome}(${2}) ${3} {",
        "\t$0",
        "}"
      ],
      "description": "Função"
    }
  }
}